# android/tools/versions.env —— 工具链版本的唯一事实来源
#
# 约定（很重要，别破坏）：
#   1. 这个文件只放"版本号 / 开关"，不放任何逻辑，谁都可以 source。
#   2. 一律写成 `: "${VAR:=默认值}"`：**环境变量永远优先**。
#      临时换版本时 `JM_API_LEVEL=35 ./build_android.sh` 即可，不用改文件、不用提交。
#   3. 能"装了什么用什么"的就别写死版本（见 JM_BUILD_TOOLS=auto）。
#   4. 任何脚本都不要再出现 android-34 / 35.0.0 / openjdk-17 / 1.29.0 这类字面量。
#
# 谁在读它：tools/env.sh（几乎所有脚本的入口）、build_android.sh、
#           build_arm64.sh、build_x86_64.sh、tools/wsl_*.sh、tools/pin_min_sdk.sh

# ---------------------------------------------------------------- Android 平台
# compileSdk / targetSdk / p4a 的 --android-api 都取这个值。
# 改它会改变 APK 的 targetSdk 行为（Android 15 强制边到边等），不是无痛改动。
: "${JM_API_LEVEL:=34}"

# minSdk：用户口径"不考虑 Android 14 以下"，改动会直接影响可安装设备范围。
: "${JM_MIN_SDK:=34}"

# build-tools：
#   auto          -> 用 $SDK/build-tools 下已装的最高版本（推荐，AGP 自己也会这么选）
#   <具体版本号>   -> 强制使用（如 35.0.0）
: "${JM_BUILD_TOOLS:=auto}"

# ---------------------------------------------------------------- JDK / Gradle
# 基线（0.88 起）：JDK 25 LTS + Gradle 9.x，仍留在 AGP 8.x（p4a 模板只认这套 DSL）。
# 版本对应关系（Gradle 官方矩阵）：
#   Java 17~24 -> Gradle 8.14 就能跑
#   Java 25    -> 需要 Gradle 9.1.0+
#   Java 26/27 -> 需要 Gradle 9.4 / 9.8
# 所以 JM_JDK_MAX 与 JM_GRADLE_MIN 必须成对调整，否则 Gradle 会在 Groovy 初始化
# 阶段抛 "Unsupported class file major version"（报错位置和真实原因完全无关）。
: "${JM_JDK_MIN:=17}"
: "${JM_JDK_MAX:=25}"

# Gradle 下限：9.1.0 才支持 Java 25；同时已包含 8.14.6 修掉的 3 个 high 级公告
# （daemon 反序列化 ×2 + TLS 失败后回落其它仓库）。
: "${JM_GRADLE_MIN:=9.1.0}"
# 非空则把 p4a 模板与 dist 里的 gradle-wrapper.properties 改写成这个版本。
# 必须在第一次 gradle 调用之前改（JDK 25 跑不了 8.14.x 的 wrapper），
# 所以 build_android.sh 在打包前会先改 p4a 模板，而不是等打完包再改。
: "${JM_GRADLE_VERSION:=9.8.2}"

# ---------------------------------------------------------------- 原生工具链
# NDK 最低主版本：r28 起默认按 16KB 页对齐编译；实际选哪个由 tools/resolve_ndk.sh 决定
: "${JM_NDK_MIN_MAJOR:=28}"
# CMake 最低版本（libsr_qnn 的 CMakeLists 要求 3.20）
: "${JM_CMAKE_MIN:=3.20}"
# 宿主 Python 最低版本（pyside6-android-deploy / buildozer 需要）
: "${JM_PYTHON_MIN:=3.10}"

# ---------------------------------------------------------------- 下载策略
# GitHub 镜像前缀（末尾带 /）。所有 github.com / raw.githubusercontent.com 的
# 下载都会走它；置空字符串则直连。
: "${JM_GH_MIRROR_PREFIX:=https://gh-proxy.com/}"
# aria2c 多线程下载的每服务器连接数（aria2 未安装时自动回落 curl）
: "${JM_ARIA2_CONN:=16}"
# Gradle 分发包的下载模板：downloads.gradle.org 的证书链在某些网络下会让 JDK 报
# PKIX path building failed（curl 能容错而 Java 严格校验中间证书），所以默认走国内镜像。
# 可用占位符: {version}（如 9.8.2）
: "${JM_GRADLE_DIST_URL_TEMPLATE:=https://mirrors.cloud.tencent.com/gradle/gradle-{version}-all.zip}"

# ---------------------------------------------------------------- 依赖版本
# 这些不是工具链，但同样属于"会被忘记同步"的版本号，一起收口到这里。
# 各脚本仍然支持自己的老变量名（ORT / ORT_VERSION）覆盖，保持向后兼容。
: "${JM_ORT_VERSION:=1.29.0}"
